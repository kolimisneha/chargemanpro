default_platform(:ios)

platform :ios do
  desc "Revoke oldest distribution certificate if near the 3-cert limit"
  lane :cleanup_certs do
    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: true,
      in_house: false
    )
    Spaceship::ConnectAPI.client = Spaceship::ConnectAPI::Client.new(token: token)

    all_certs = Spaceship::ConnectAPI::Certificate.all
    UI.message("All certificates on account: #{all_certs.count}")
    all_certs.each do |cert|
      UI.message("  id=#{cert.id} type=#{cert.certificate_type} name=#{cert.name}")
    end

    dist_certs = all_certs.select do |cert|
      cert_type = cert.certificate_type.to_s.upcase
      cert_type.include?("DISTRIBUTION") || cert_type.include?("IOS_APP_STORE") || cert_type.include?("MAC_APP_STORE")
    end

    UI.message("Distribution/App Store certificates: #{dist_certs.count}")

    if dist_certs.count >= 2
      oldest = dist_certs.min_by { |c| c.id.to_i }
      UI.message("Revoking oldest certificate to free a slot: id=#{oldest.id} type=#{oldest.certificate_type} name=#{oldest.name}")
      oldest.delete!
      UI.message("Certificate revoked successfully")
    else
      UI.message("Under the limit, no revocation needed")
    end
  end

  desc "Generate an Apple Distribution certificate and App Store provisioning profile"
  lane :generate_signing do
    cert(
      development: false,
      output_path: "./certificates",
      team_id: ENV["APPLE_TEAM_ID"],
      keychain_path: ENV["KEYCHAIN_PATH"],
      keychain_password: ENV["KEYCHAIN_PASSWORD"],
      api_key: {
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
        is_key_content_base64: true
      }
    )
    sigh(
      app_identifier: ENV["BUNDLE_ID"],
      development: false,
      output_path: "./certificates",
      force: true,
      team_id: ENV["APPLE_TEAM_ID"],
      api_key: {
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
        is_key_content_base64: true
      }
    )
  end

  desc "Build the .ipa"
  lane :build do
    gym(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      clean: true,
      export_method: "app-store",
      export_team_id: ENV["APPLE_TEAM_ID"],
      export_options: {
        method: "app-store",
        teamID: ENV["APPLE_TEAM_ID"],
        provisioningProfiles: {
          ENV["BUNDLE_ID"] => ENV["PROFILE_SPECIFIER"]
        }
      },
      output_directory: "./build",
      output_name: "EVChargeMan"
    )
  end

  desc "Upload .ipa to App Store Connect"
  lane :upload do
    upload_to_app_store(
      app_identifier: ENV["BUNDLE_ID"],
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      api_key: {
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
        is_key_content_base64: true
      }
    )
  end
end
