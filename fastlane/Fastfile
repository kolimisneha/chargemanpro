default_platform(:ios)

platform :ios do
  desc "Revoke all distribution certificates to avoid the 2-cert limit"
  lane :cleanup_certs do
    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: true,
      in_house: false
    )
    Spaceship::ConnectAPI.client = Spaceship::ConnectAPI::Client.new(token: token)
    Spaceship::ConnectAPI::Certificate.all.each do |cert|
      next unless cert.certificate_type.to_s.include?("DISTRIBUTION")
      UI.message("Revoking #{cert.id} (#{cert.certificate_type})")
      cert.delete!
    end
  end

  desc "Generate an Apple Distribution certificate and App Store provisioning profile"
  lane :generate_signing do
    cert(
      development: false,
      output_path: "./certificates",
      team_id: ENV["APPLE_TEAM_ID"],
      keychain_path: ENV["KEYCHAIN_PATH"],
      keychain_password: ENV["KEYCHAIN_PASSWORD"],
      api_key: {
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
        is_key_content_base64: true
      }
    )
    sigh(
      app_identifier: ENV["BUNDLE_ID"],
      development: false,
      output_path: "./certificates",
      force: true,
      team_id: ENV["APPLE_TEAM_ID"],
      api_key: {
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
        is_key_content_base64: true
      }
    )
  end

  desc "Build the .ipa and upload it to App Store Connect"
  lane :release do
    gym(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      clean: true,
      export_method: "app-store",
      export_team_id: ENV["APPLE_TEAM_ID"],
      export_options: {
        method: "app-store",
        teamID: ENV["APPLE_TEAM_ID"],
        provisioningProfiles: {
          ENV["BUNDLE_ID"] => ENV["PROFILE_SPECIFIER"]
        }
      },
      output_directory: "./build",
      output_name: "EVChargeMan"
    )
    upload_to_app_store(
      app_identifier: ENV["BUNDLE_ID"],
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      api_key: {
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
        is_key_content_base64: true
      }
    )
  end
end
