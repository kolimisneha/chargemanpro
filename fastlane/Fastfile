default_platform(:ios)

platform :ios do
  desc "List all apps and their bundle IDs in App Store Connect"
  lane :list_apps do
    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: true,
      in_house: false
    )
    Spaceship::ConnectAPI.client = Spaceship::ConnectAPI::Client.new(token: token)
    Spaceship::ConnectAPI::App.all.each do |app|
      UI.message("#{app.name} | BUNDLE_ID=#{app.bundle_id} | SKU=#{app.sku}")
    end
  end

  desc "Generate an Apple Distribution certificate and App Store provisioning profile"
  lane :generate_signing do
    cert(
      development: false,
      output_path: "./certificates",
      team_id: ENV["APPLE_TEAM_ID"],
      api_key: {
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
        is_key_content_base64: true
      }
    )
    sigh(
      app_identifier: ENV["BUNDLE_ID"],
      development: false,
      output_path: "./certificates",
      force: true,
      team_id: ENV["APPLE_TEAM_ID"],
      api_key: {
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
        is_key_content_base64: true
      }
    )
  end

  desc "Build the .ipa and upload it to App Store Connect"
  lane :release do
    gym(
      scheme: "App",
      clean: true,
      export_method: "app-store",
      development_team: ENV["APPLE_TEAM_ID"],
      xcargs: "CODE_SIGN_STYLE='Manual' DEVELOPMENT_TEAM='#{ENV['APPLE_TEAM_ID']}' PROVISIONING_PROFILE_SPECIFIER='#{ENV['PROFILE_SPECIFIER']}'",
      output_directory: "./build",
      output_name: "EVChargeMan"
    )
    upload_to_app_store(
      app_identifier: ENV["BUNDLE_ID"],
      skip_metadata: true,
      skip_screenshots: true,
      skip_app_icon_upload: true,
      skip_pdf: true,
      submit_for_review: false,
      api_key: {
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
        is_key_content_base64: true
      }
    )
  end
end
